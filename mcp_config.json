{
  "mcpServers": {
    "mcp-server-github": {
      "command": "uv",
      "args": [
        "--directory",
        "./mcp-server-github",
        "run",
        "mcp-server-github",
        "--transport",
        "streamable-http",
        "--host",
        "0.0.0.0",
        "--port",
        "8085"
      ],
      "env": {
        "PORT": "8085"
      }
    },
    "mcp-server-github-production": {
      "url": "https://mcp-server-github-ozarbv64lq-uc.a.run.app/mcp"
    },
    "adk-docs-mcp": {
      "command": "uvx",
      "args": [
        "--from",
        "mcpdoc",
        "mcpdoc",
        "--urls",
        "AgentDevelopmentKit:https://adk.dev/llms.txt",
        "--transport",
        "stdio"
      ]
    },
    "cloudrun": {
      "command": "npx",
      "args": [
        "-y",
        "@google-cloud/cloud-run-mcp"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    }
  }
}
