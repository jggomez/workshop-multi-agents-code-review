# Gemini Model Configuration
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_CRITIC_MODEL=gemini-2.5-flash

# Vertex AI Configuration
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Alternatively, for Gemini API via Google AI Studio:
# GEMINI_API_KEY=your-api-key-here

# MCP Server Configuration
MCP_SERVER_URL=http://127.0.0.1:8085/mcp
GITHUB_PERSONAL_ACCESS_TOKEN=

# ==============================================================================
# A2A Protocol Agent RPC & Card URLs
# ==============================================================================
A2A_WELL_KNOWN_AGENT_CARD_URL=http://localhost:8000/.well-known/agent.json

# Root Pipeline Agent (SequentialAgent)
A2A_ROOT_AGENT_RPC_URL=http://localhost:8000/a2a/app
A2A_ROOT_AGENT_CARD_URL=http://localhost:8000/a2a/app/.well-known/agent-card.json

# Sub-agent: Investigator Agent
A2A_INVESTIGATOR_AGENT_RPC_URL=http://localhost:8000/a2a/pr_investigator_agent
A2A_INVESTIGATOR_AGENT_CARD_URL=http://localhost:8000/a2a/pr_investigator_agent/.well-known/agent-card.json

# Sub-agent: Critical Reviewer Agent (LoopAgent)
A2A_CRITICAL_REVIEWER_AGENT_RPC_URL=http://localhost:8000/a2a/critical_reviewer_agent
A2A_CRITICAL_REVIEWER_AGENT_CARD_URL=http://localhost:8000/a2a/critical_reviewer_agent/.well-known/agent-card.json

# Sub-agent: Technical Report Generator Agent
A2A_REPORT_AGENT_RPC_URL=http://localhost:8000/a2a/pr_report_agent
A2A_REPORT_AGENT_CARD_URL=http://localhost:8000/a2a/pr_report_agent/.well-known/agent-card.json
